{
  "name": "web-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/check-facts.mjs && node scripts/check-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "stylelint": "stylelint \"app/**/*.css\" \"components/**/*.css\"",
    "test": "node tests/content.test.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run lint && npm run stylelint && npm test && npm run check:facts && npm run check:assets",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.3.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
